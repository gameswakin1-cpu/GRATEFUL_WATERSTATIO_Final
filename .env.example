# Copy this file to .env and replace the placeholders locally.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOST=localhost
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=replace-me
DB_HOST=your-neon-host
DB_PORT=5432
DB_SSLMODE=require

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

MAPBOX_API_KEY=
CARTO_API_KEY=

# Connect a private Blob store to the Vercel project to enable OIDC authentication.
# For local development, set a private store's read-write token:
# BLOB_READ_WRITE_TOKEN=
